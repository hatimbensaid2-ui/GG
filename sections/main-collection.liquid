{%- paginate collection.products by section.settings.per_page -%}
<div class="collection-hero polka">
  <div class="page-width">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="collection-hero__desc rte">{{ collection.description }}</div>{%- endif -%}
  </div>
</div>
<div class="section" style="--cols: {{ section.settings.columns }};">
  <div class="page-width">
    <div class="collection-toolbar">
      <span class="collection-toolbar__count">{{ 'collections.general.product_count' | t: count: collection.products_count }}</span>
      {%- if collection.sort_options.size > 0 -%}
        <form method="get" class="collection-toolbar__sort">
          {%- for filter in collection.filters -%}{%- for v in filter.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}{%- endfor -%}
          <label class="visually-hidden" for="SortBy">{{ 'collections.general.sort_by' | t }}</label>
          <select id="SortBy" name="sort_by" onchange="this.form.submit()">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      {%- endif -%}
    </div>

    <div class="{% if section.settings.show_filters and collection.filters.size > 0 %}collection-layout{% endif %}">
      {%- if section.settings.show_filters and collection.filters.size > 0 -%}
        <form class="facets" method="get">
          <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' -%}
              <div class="facets__group">
                <div class="facets__group-title">{{ filter.label }}</div>
                <ul class="facets__list">
                  {%- for value in filter.values -%}
                    <li><label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} onchange="this.form.submit()"> {{ value.label }} <span style="opacity:.5;">({{ value.count }})</span></label></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
          <a href="{{ collection.url }}" class="link-underline" style="display:inline-block;margin-top:1rem;">{{ 'collections.general.clear' | t }}</a>
        </form>
      {%- endif -%}
      <div>
        {%- if collection.products.size > 0 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p style="text-align:center;padding:3rem 0;">{{ 'collections.general.no_products' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true }
  ]
}
{% endschema %}
