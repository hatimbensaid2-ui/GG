<div class="section">
  <div class="page-width page-width--narrow">
    <div class="page-hero"><h1>{{ 'sections.cart.title' | t }}</h1></div>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a class="cart-item__img" href="{{ item.url }}">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" loading="lazy" width="200" height="266">{%- endif -%}</a>
            <div>
              <a href="{{ item.url }}"><h4 class="cart-item__title">{{ item.product.title }}</h4></a>
              {%- unless item.product.has_only_default_variant -%}<div class="cart-item__variant">{{ item.variant.title }}</div>{%- endunless -%}
              {%- for d in item.line_level_discount_allocations -%}<div class="cart-item__discount">{{ d.discount_application.title }} (−{{ d.amount | money }})</div>{%- endfor -%}
              <div class="cart-item__qty">
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" aria-label="-">&minus;</a>
                <span>{{ item.quantity }}</span>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="+">+</a>
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-item__remove" style="display:block;">{{ 'sections.cart.remove' | t }}</a>
            </div>
            <div class="cart-item__price">
              {%- if item.original_line_price > item.final_line_price -%}
                <span class="cart-item__price-was">{{ item.original_line_price | money }}</span><span class="cart-item__price-now">{{ item.final_line_price | money }}</span>
              {%- else -%}{{ item.final_line_price | money }}{%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        <div style="margin-top:2rem;text-align:right;">
          <div class="cart-page__discounts">
            {%- for d in cart.cart_level_discount_applications -%}
              <div class="cart-drawer__discount-row" style="gap:1rem;"><span>{{ d.title }}</span><span>−{{ d.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
          </div>
          <p style="font-weight:700;font-size:1.2rem;margin-bottom:.3rem;">{{ 'sections.cart.subtotal' | t }}: {{ cart.total_price | money_with_currency }}</p>
          <p class="cart-drawer__tax">{{ 'sections.cart.taxes_note' | t }}</p>
          <textarea name="note" placeholder="Add a note to your order" style="width:100%;max-width:420px;border:1.5px solid var(--color-border);border-radius:var(--radius);padding:.8rem 1rem;font-family:inherit;margin-bottom:1rem;">{{ cart.note }}</textarea>
          <div><button type="submit" name="checkout" class="btn">{{ 'sections.cart.checkout' | t }}</button></div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">{{ 'sections.cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
