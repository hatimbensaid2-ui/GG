<div class="section section--bg-{{ section.settings.background }}" style="--cols: {{ section.settings.columns }};">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="section-header__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.show_summary -%}
        <div class="review-summary">
          <span class="review-summary__stars">★★★★★</span>
          <span><strong>{{ section.settings.rating_avg }}</strong>/5 {{ 'general.reviews.from' | t }} {{ section.settings.review_count }} {{ 'general.reviews.reviews' | t }}</span>
        </div>
      {%- endif -%}
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <div class="testimonial{% if block.settings.image != blank %} testimonial--photo{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="testimonial__photo">
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.author | escape }}" loading="lazy" width="600" height="600">
            </div>
          {%- endif -%}
          <div class="testimonial__body">
            <div class="testimonial__stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div>
            <p class="testimonial__text">“{{ block.settings.quote }}”</p>
            <div class="testimonial__author">{{ block.settings.author }} <span class="review__verified">{{ 'general.reviews.verified' | t }}</span></div>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="testimonial__product">{{ block.settings.product.title }} →</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Plain" }, { "value": "polka", "label": "Polka dots" }, { "value": "soft", "label": "Soft pink" } ], "default": "none" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by you" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The girls have spoken" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary", "default": true },
    { "type": "text", "id": "rating_avg", "label": "Average rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Number of reviews", "default": "1,200+" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 1, "max": 4, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Obsessed! The fit is so flattering and the fabric feels amazing. Getting compliments every time I wear it." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sofia R." },
        { "type": "product", "id": "product", "label": "Product reviewed" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Testimonials", "blocks": [
      { "type": "review", "settings": { "author": "Sofia R.", "quote": "Obsessed! The fit is so flattering and the fabric feels like a dream." } },
      { "type": "review", "settings": { "author": "Maya L.", "quote": "Fast shipping and everything is even cuter in person. My new favourite shop." } },
      { "type": "review", "settings": { "author": "Chloe T.", "quote": "The vibe is exactly what I wanted for my soft girl wardrobe. 10/10." } }
    ] }
  ]
}
{% endschema %}
