{%- paginate search.results by 24 -%}
<div class="section">
  <div class="page-width">
    <div class="collection-hero">
      <h1>{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:480px;margin:1.5rem auto 0;display:flex;gap:.5rem;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="flex:1;padding:.9rem 1.2rem;border-radius:999px;border:1.5px solid var(--color-border);font-family:inherit;">
        <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <p style="text-align:center;opacity:.7;margin-bottom:1.5rem;">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
        <div class="product-grid" style="--cols:4;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="article-card">
                <h3 class="article-card__title">{{ item.title }}</h3>
                <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p style="text-align:center;padding:3rem 0;">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
