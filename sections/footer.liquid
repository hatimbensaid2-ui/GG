<footer class="footer" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" loading="lazy" width="{{ section.settings.logo_width }}" height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}" style="width:{{ section.settings.logo_width }}px;margin-bottom:.8rem;">
        {%- else -%}
          <p class="footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.brand_text != blank -%}<div class="footer__brand-text">{{ section.settings.brand_text }}</div>{%- endif -%}
        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <div class="footer__col-title">{{ block.settings.title | default: block.settings.menu.title }}</div>
              {%- if block.settings.menu != blank -%}
                <ul class="footer__list">
                  {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- when 'newsletter' -%}
            <div class="footer__col footer__col--news footer__newsletter" {{ block.shopify_attributes }}>
              <div class="footer__col-title">{{ block.settings.title }}</div>
              {%- if block.settings.text != blank -%}<p style="font-size:.9rem;opacity:.85;">{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', id: 'FooterNewsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="newsletter__success">{{ 'general.newsletter.success' | t }}</p>
                {%- else -%}
                  <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="Email" required>
                  <button type="submit" class="btn btn--accent btn--full">{{ 'general.newsletter.button' | t }}</button>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}{% if section.settings.copyright != blank %} · {{ section.settings.copyright }}{% endif %}</div>

      {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'footer__localization' -%}
          <select name="country_code" onchange="this.form.submit()" aria-label="{{ 'general.localization.country' | t }}" style="background:transparent;color:inherit;border:1px solid rgba(255,248,245,.4);border-radius:999px;padding:.4rem .8rem;font-family:inherit;">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %} style="color:#3A2A2F;">{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_payment -%}
        <div class="footer__payment">
          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 150 },
    { "type": "richtext", "id": "brand_text", "label": "Brand text", "default": "<p>Heavenly made, dreamy & frilly fashion for your soft girl era. Coquette, dollette & ballet-core pieces you'll want to live in.</p>" },
    { "type": "checkbox", "id": "show_localization", "label": "Show country/currency selector", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright", "label": "Extra copyright text" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Join the club" },
        { "type": "text", "id": "text", "label": "Text", "default": "Early access to drops & 10% off your first order." }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
