<footer class="footer" role="contentinfo">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="140" style="filter:brightness(0) invert(1);margin-bottom:1rem;">
        {%- else -%}
          <p class="footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="footer__brand-text">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__col-title">{{ block.settings.heading }}</div>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <div class="footer__col-title">{{ block.settings.heading }}</div>
              <p class="footer__brand-text" style="margin-bottom:1rem;">{{ block.settings.text }}</p>
              {%- form 'customer', class: 'footer__newsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p>{{ 'general.newsletter.success' | t }}</p>
                {%- else -%}
                  <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
                  <button type="submit" class="btn btn--accent btn--full">{{ 'general.newsletter.button' | t }}</button>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name }} — {{ 'general.footer.rights' | t }}</div>
      {%- if section.settings.show_payment -%}
        <div class="footer__payment">
          <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>KLARNA</span><span>APPLE PAY</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Soft looks for the main character. Curated drops, dreamy fits, delivered worldwide." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the club" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get 10% off your first order plus early access to drops." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
