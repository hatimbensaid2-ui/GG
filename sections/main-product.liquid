<div class="section" data-product-root>
  <div class="page-width">
    <div class="product">
      {%- comment -%} Gallery — swipeable / draggable slider {%- endcomment -%}
      <div class="product__gallery">
        <div class="product__slider-wrap">
          <div class="product__slider" data-gallery>
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="product__slide" data-slide="{{ forloop.index0 }}">
                  <img src="{{ media | image_url: width: 1000 }}" alt="{{ media.alt | escape }}" width="1000" height="1333" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %} draggable="false">
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="product__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <button type="button" class="product__nav product__nav--prev" data-gallery-prev aria-label="Previous image">{% render 'icon-chevron' %}</button>
            <button type="button" class="product__nav product__nav--next" data-gallery-next aria-label="Next image">{% render 'icon-chevron' %}</button>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media limit: 10 -%}
              <button type="button" class="product__thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | escape }}" loading="lazy" width="200" height="267">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Info {%- endcomment -%}
      <div class="product__info">
        {%- if product.vendor != blank -%}<div class="product__vendor">{{ product.vendor }}</div>{%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>

        {%- if section.settings.rating_source == 'judgeme' -%}
          <div class="jdgm-widget jdgm-preview-badge product__rating-jdgm" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}"></div>
        {%- else -%}
          <a href="#reviews" class="product__rating">
            <span class="stars">★★★★★</span>
            <span>{{ section.settings.rating_text }}</span>
          </a>
        {%- endif -%}

        <div class="product__price">
          {% render 'price', product: product, large: true %}
        </div>

        <form data-product-form>
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="product__option">
                <span class="product__option-label">{{ option.name }}</span>
                <div class="product__option-values">
                  {%- for value in option.values -%}
                    <button type="button" class="option-pill" data-option-index="{{ forloop.parentloop.index0 }}" data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          {%- if product.metafields.custom.size_chart != blank or section.settings.size_guide_image != blank -%}
            <button type="button" class="product__size-guide-link" data-size-guide-open>
              {% render 'icon-ruler' %} {{ 'products.size_guide.link' | t }}
            </button>
          {%- endif -%}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <div class="product__form-actions">
            <div class="product__qty">
              <button type="button" data-qty-down aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" data-qty-up aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" class="btn btn--full" data-add-btn {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
            {%- if section.settings.show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        </form>

        {%- if section.settings.show_meta -%}
          <div class="product__meta">
            <span>{% render 'icon-truck' %} {{ section.settings.meta_shipping }}</span>
            <span>{% render 'icon-return' %} {{ section.settings.meta_returns }}</span>
          </div>
        {%- endif -%}

        <div class="product__accordions">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'accordion' -%}
                {%- assign btitle = block.settings.title | downcase -%}
                {%- if btitle contains 'size' and product.metafields.custom.size_chart != blank -%}
                  {%- comment -%} Size & care block becomes the size chart when the product has one {%- endcomment -%}
                  <div class="accordion" id="size-guide-anchor" {{ block.shopify_attributes }}>
                    <button type="button" class="accordion__head">{{ 'products.size_guide.title' | t }} {% render 'icon-plus' %}</button>
                    <div class="accordion__body accordion__body--tall">
                      <div class="accordion__inner">
                        <div class="size-guide__table rte">{{ product.metafields.custom.size_chart.value }}</div>
                        {%- if section.settings.size_guide_image != blank -%}
                          <div class="size-guide__image" style="margin-top:1rem;">
                            <img src="{{ section.settings.size_guide_image | image_url: width: 1100 }}" alt="{{ 'products.size_guide.title' | t }}" loading="lazy">
                          </div>
                        {%- endif -%}
                        <p class="size-guide__note">{{ 'products.size_guide.note' | t }}</p>
                      </div>
                    </div>
                  </div>
                {%- else -%}
                  <div class="accordion" {{ block.shopify_attributes }}>
                    <button type="button" class="accordion__head">{{ block.settings.title }} {% render 'icon-plus' %}</button>
                    <div class="accordion__body"><div class="accordion__inner rte">{{ block.settings.content }}</div></div>
                  </div>
                {%- endif -%}
              {%- when 'description' -%}
                <div class="accordion is-open" {{ block.shopify_attributes }}>
                  <button type="button" class="accordion__head">{{ 'products.product.details' | t }} {% render 'icon-plus' %}</button>
                  <div class="accordion__body" style="max-height:none;"><div class="accordion__inner rte">{{ product.description }}</div></div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} Bundle / complete the look {%- endcomment -%}
    {%- assign bundle_products = product.metafields.custom.bundles.value -%}
    {%- if bundle_products != blank and bundle_products.size > 0 -%}
      <div class="pdp-bundle">
        <div class="pdp-bundle__title">{{ 'products.bundle.title' | t }}</div>
        <div class="pdp-bundle__items">
          {%- for p in bundle_products -%}
            <div class="pdp-bundle__item">
              <a href="{{ p.url }}" class="pdp-bundle__img">
                {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 200 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy">{%- endif -%}
              </a>
              <div class="pdp-bundle__info">
                <a href="{{ p.url }}" class="pdp-bundle__name">{{ p.title }}</a>
                {% render 'price', product: p %}
                {%- if p.available and p.has_only_default_variant == false -%}
                  <select class="pdp-bundle__variant" aria-label="{{ p.title | escape }}">
                    {%- for v in p.variants -%}
                      <option value="{{ v.id }}" {% if v.id == p.selected_or_first_available_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
              </div>
              {%- if p.available -%}
                <button type="button" class="pdp-bundle__add" data-bundle-add data-default-id="{{ p.selected_or_first_available_variant.id }}" aria-label="{{ 'products.product.add_to_cart' | t }}">+</button>
              {%- else -%}
                <span class="pdp-bundle__soldout">{{ 'products.product.sold_out' | t }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>


  <div class="pdp-sticky" data-pdp-sticky>
    <div class="pdp-sticky__info">
      <span class="pdp-sticky__title">{{ product.title }}</span>
      <div class="pdp-sticky__price">{% render 'price', product: product %}</div>
    </div>
    <button type="button" class="btn" data-sticky-add {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
    </button>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</div>

{%- comment -%} Related products {%- endcomment -%}
{%- if section.settings.show_related and product.collections.first -%}
  <div class="section" style="--cols:4;">
    <div class="page-width">
      <div class="section-header"><h2 class="section-header__title">{{ 'products.product.related' | t }}</h2></div>
      <div class="product-grid">
        {%- assign count = 0 -%}
        {%- for p in product.collections.first.products -%}
          {%- if p.id != product.id and count < 4 -%}
            {% render 'product-card', product: p %}
            {%- assign count = count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Product reviews (Judge.me widget) {%- endcomment -%}
{%- if section.settings.show_reviews -%}
  {%- liquid
    assign app_block_count = 0
    for block in section.blocks
      if block.type == '@app'
        assign app_block_count = app_block_count | plus: 1
      endif
    endfor
  -%}
  <div class="section reviews" id="reviews">
    <div class="page-width">
      <div class="section-header"><h2 class="section-header__title">{{ section.settings.reviews_title }}</h2></div>
      {%- if app_block_count > 0 -%}
        {%- comment -%} Review apps (Judge.me etc.) added via the theme editor render here {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      {%- elsif section.settings.rating_source == 'judgeme' -%}
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-product-title="{{ product.title | escape }}"></div>
      {%- else -%}
        <p style="text-align:center;opacity:.7;">{{ 'products.reviews.based_on' | t: count: section.settings.rating_text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "header", "content": "Reviews" },
    { "type": "select", "id": "rating_source", "label": "Rating badge", "options": [ { "value": "judgeme", "label": "Judge.me badge" }, { "value": "static", "label": "Static text" } ], "default": "judgeme" },
    { "type": "text", "id": "rating_text", "label": "Static rating text", "default": "4.9 (2,431 reviews)" },
    { "type": "checkbox", "id": "show_reviews", "label": "Show reviews section", "default": true },
    { "type": "text", "id": "reviews_title", "label": "Reviews heading", "default": "What the girls are saying" },
    { "type": "header", "content": "Size guide" },
    { "type": "image_picker", "id": "size_guide_image", "label": "Size guide / measuring image", "info": "Shared measuring guide shown in the size-guide popup. The per-product size table comes from the product's 'Size chart' metafield." },
    { "type": "header", "content": "Product" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "checkbox", "id": "show_meta", "label": "Show shipping/returns note", "default": true },
    { "type": "text", "id": "meta_shipping", "label": "Shipping note", "default": "Free shipping over $90" },
    { "type": "text", "id": "meta_returns", "label": "Returns note", "default": "30-day easy returns" },
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free shipping over $90. Easy 30-day returns on all orders.</p>" }
      ]
    }
  ]
}
{% endschema %}
