<div class="announcement {% if section.settings.scrolling %}announcement--scrolling{% endif %}" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }};">
  <div class="announcement__track">
    {%- if section.settings.scrolling -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <span class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
          </span>
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign block = section.blocks.first -%}
      {%- if block -%}
        <span class="announcement__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "scrolling", "label": "Scroll messages", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#C25C7A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $90 ✿" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {},
    "blocks": [
      { "type": "message", "settings": { "text": "Free shipping on orders over $90 ✿" } },
      { "type": "message", "settings": { "text": "New drops every week — join the club 🎀" } },
      { "type": "message", "settings": { "text": "Student discount available at checkout" } }
    ]
  }
}
{% endschema %}
