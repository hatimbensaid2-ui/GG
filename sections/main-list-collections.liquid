<div class="section" style="--cols:3;">
  <div class="page-width">
    <div class="section-header"><h1 class="section-header__title">{{ 'collections.list.title' | t }}</h1></div>
    <div class="collection-tiles">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 700 }}" alt="{{ collection.title | escape }}" loading="lazy" width="700" height="933">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <div class="collection-tile__overlay"><div>
            <h3 class="collection-tile__title">{{ collection.title }}</h3>
            <span class="collection-tile__cta">{{ collection.products_count }} {{ 'collections.list.items' | t }}</span>
          </div></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "List collections", "settings": [] }
{% endschema %}
