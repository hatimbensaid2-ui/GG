{%- paginate blog.articles by 9 -%}
<div class="section">
  <div class="page-width">
    <div class="page-hero"><h1>{{ blog.title }}</h1></div>
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy" width="700" height="525">
            {%- else -%}
              <div class="polka" style="width:100%;height:100%;"></div>
            {%- endif -%}
          </div>
          <div class="article-card__meta">{{ article.published_at | date: '%b %d, %Y' }}</div>
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
