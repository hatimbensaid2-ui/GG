{%- paginate blog.articles by 9 -%}
<div class="section">
  <div class="page-width">
    <div class="collection-hero"><h1>{{ blog.title }}</h1></div>
    <div class="article-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" width="600" height="450">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="article-card__meta">{{ article.published_at | date: '%b %d, %Y' }}</div>
          <h3 class="article-card__title">{{ article.title }}</h3>
          <p style="opacity:.75;font-size:.9rem;">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
