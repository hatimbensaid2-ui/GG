<div class="marquee marquee--{{ section.settings.style }}">
  <div class="marquee__track">
    {%- for i in (1..4) -%}
      {%- for block in section.blocks -%}
        <span class="marquee__item" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "polka", "label": "Polka dots" }, { "value": "pink", "label": "Pink" }, { "value": "dark", "label": "Dark" } ], "default": "polka" }
  ],
  "blocks": [
    { "type": "text", "name": "Text", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Polka dot season" } ] }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Scrolling text", "blocks": [
      { "type": "text", "settings": { "text": "Polka dot season" } },
      { "type": "text", "settings": { "text": "Heavenly made" } },
      { "type": "text", "settings": { "text": "Frilly & dreamy" } },
      { "type": "text", "settings": { "text": "Coquette forever" } }
    ] }
  ]
}
{% endschema %}
