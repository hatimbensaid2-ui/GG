{%- liquid
  assign menu = section.settings.menu
-%}
<header class="header" role="banner">
  <div class="page-width header__inner">
    <button type="button" class="header__menu-toggle" data-menu-open aria-label="{{ 'accessibility.menu' | t }}">{% render 'icon-menu' %}</button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_h = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        <img src="{{ section.settings.logo | image_url: width: 600 }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
             width="{{ section.settings.logo_width }}" height="{{ logo_h }}" style="width:{{ section.settings.logo_width }}px;max-height:none;">
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'accessibility.main_nav' | t }}">
      {%- if menu != blank -%}
        <ul class="nav-menu">
          {%- for link in menu.links -%}
            {%- liquid
              assign title_down = link.title | downcase
              assign is_sale = false
              if title_down contains 'sale' or title_down contains 'clearance'
                assign is_sale = true
              endif
            -%}
            <li class="nav-menu__item{% if link.links.size > 0 %} nav-menu__item--has-mega{% endif %}{% if is_sale %} nav-menu__item--sale{% endif %}">
              <a href="{{ link.url }}" class="nav-menu__link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <div class="mega">
                  <div class="page-width mega__inner">
                    {%- assign has_grandchildren = false -%}
                    {%- for child in link.links -%}{%- if child.links.size > 0 -%}{%- assign has_grandchildren = true -%}{%- endif -%}{%- endfor -%}
                    {%- if has_grandchildren -%}
                      {%- for child in link.links -%}
                        <div class="mega__col">
                          <a href="{{ child.url }}" class="mega__heading" style="display:block;">{{ child.title }}</a>
                          <ul class="mega__list">
                            {%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title }}</a></li>{%- endfor -%}
                          </ul>
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {%- assign per_col = link.links.size | plus: 1 | divided_by: 2 | at_least: 5 -%}
                      <div class="mega__col">
                        <div class="mega__heading">{{ link.title }}</div>
                        <ul class="mega__list">
                          {%- for child in link.links -%}
                            {%- if forloop.index0 > 0 and forloop.index0 == per_col -%}</ul></div><div class="mega__col"><div class="mega__heading">&nbsp;</div><ul class="mega__list">{%- endif -%}
                            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                    {%- for block in section.blocks -%}
                      {%- if block.settings.menu_item != blank and block.settings.menu_item == link.title -%}
                        <a href="{{ block.settings.link | default: link.url }}" class="mega__promo" {{ block.shopify_attributes }}>
                          {%- if block.settings.image != blank -%}
                            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}">
                          {%- else -%}
                            {{ 'lifestyle-1' | placeholder_svg_tag }}
                          {%- endif -%}
                          {%- if block.settings.caption != blank -%}<div class="mega__promo-caption">{{ block.settings.caption }}</div>{%- endif -%}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <div class="header__actions">
      <button type="button" class="header__action header__action--search" data-search-open aria-label="{{ 'general.search.title' | t }}">{% render 'icon-search' %}</button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__action header__action--account" aria-label="{{ 'customer.account.title' | t }}">{% render 'icon-account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__action" data-cart-open aria-label="{{ 'sections.cart.title' | t }}">
        {% render 'icon-cart' %}
        <span class="cart-count" style="display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %};">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile drawer {%- endcomment -%}
<div id="MobileNav" class="mobile-nav" aria-label="{{ 'accessibility.menu' | t }}">
  <div class="mobile-nav__head">
    <span class="header__logo-text" style="font-size:1.3rem;">{{ shop.name }}</span>
    <button type="button" class="cart-drawer__close" data-menu-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
  </div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form" style="margin-bottom:1rem;">
    <span class="search-modal__icon">{% render 'icon-search' %}</span>
    <input type="search" name="q" class="search-modal__input" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
  </form>
  {%- if menu != blank -%}
    <ul class="mobile-nav__list">
      {%- for link in menu.links -%}
        <li class="mobile-nav__item">
          {%- if link.links.size > 0 -%}
            <button type="button" class="mobile-nav__toggle-sub" aria-label="{{ link.title | escape }}">+</button>
          {%- endif -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <ul class="mobile-nav__sub">
              {%- for child in link.links -%}
                <li class="mobile-nav__item">
                  <a href="{{ child.url }}">{{ child.title }}</a>
                  {%- if child.links.size > 0 -%}
                    <ul class="mobile-nav__sub" style="display:block;">
                      {%- for grand in child.links -%}<li><a href="{{ grand.url }}" style="font-weight:400;">{{ grand.title }}</a></li>{%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  <div class="mobile-nav__foot">
    {%- if shop.customer_accounts_enabled -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="link-underline">{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.login.title' | t }}{% endif %}</a>
    {%- endif -%}
  </div>
  {% render 'social-icons' %}
</div>

{%- comment -%} Search modal {%- endcomment -%}
<div id="SearchModal" class="search-modal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}">
  <div class="search-modal__overlay" data-search-close></div>
  <div class="search-modal__panel">
    <div class="page-width">
      <div class="search-modal__bar">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
          <span class="search-modal__icon">{% render 'icon-search' %}</span>
          <input type="search" name="q" class="search-modal__input" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}" autocomplete="off" data-predictive-input>
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="search-modal__submit">{{ 'general.search.submit' | t }}</button>
        </form>
        <button type="button" class="search-modal__close" data-search-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon-close' %}</button>
      </div>
      <div class="search-modal__results" data-predictive-results></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Items named 'Sale' or 'Clearance' are highlighted. Nested items appear in a dropdown." }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Dropdown image",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item title", "info": "Exact title of the top-level menu item, e.g. Shop" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Shop new arrivals" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
