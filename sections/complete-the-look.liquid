{%- comment -%} Complete the look — shoppable outfit. Reuses the bundle add-to-bag logic in theme.js {%- endcomment -%}
<div class="section section--bg-{{ section.settings.background }}">
  <div class="page-width">
    <div class="look {% if section.settings.reverse %}look--reverse{% endif %}">
      <div class="look__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1100 }}" srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1100 }} 1100w" sizes="(max-width: 990px) 100vw, 50vw" alt="{{ section.settings.image.alt | default: section.settings.title | escape }}" loading="lazy" width="1100" height="1375">
        {%- elsif section.blocks.first.settings.product.featured_image -%}
          {%- assign lead = section.blocks.first.settings.product -%}
          <img src="{{ lead.featured_image | image_url: width: 1100 }}" alt="{{ lead.title | escape }}" loading="lazy" width="1100" height="1375">
        {%- else -%}
          <div class="polka--pink" style="aspect-ratio:4/5;border-radius:var(--radius);"></div>
        {%- endif -%}
        {%- if section.settings.sticker != blank -%}<span class="look__sticker">{{ section.settings.sticker }}</span>{%- endif -%}
      </div>

      <div class="look__content">
        {%- if section.settings.eyebrow != blank -%}<span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="look__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="look__text">{{ section.settings.text }}</p>{%- endif -%}

        <div class="look__items">
          {%- assign shown = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              {%- assign shown = shown | plus: 1 -%}
              <div class="pdp-bundle__item look__item" {{ block.shopify_attributes }}>
                <a href="{{ p.url }}" class="pdp-bundle__img">
                  {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 200 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy" width="200" height="266">{%- endif -%}
                </a>
                <div class="pdp-bundle__info">
                  <a href="{{ p.url }}" class="pdp-bundle__name">{{ p.title }}</a>
                  {% render 'price', product: p %}
                  {%- if p.available and p.has_only_default_variant == false -%}
                    <select class="pdp-bundle__variant" aria-label="{{ p.title | escape }}">
                      {%- for v in p.variants -%}
                        <option value="{{ v.id }}" {% if v.id == p.selected_or_first_available_variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
                      {%- endfor -%}
                    </select>
                  {%- endif -%}
                </div>
                {%- if p.available -%}
                  <button type="button" class="pdp-bundle__add" data-bundle-add data-default-id="{{ p.selected_or_first_available_variant.id }}" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ p.title | escape }}">+</button>
                {%- else -%}
                  <span class="pdp-bundle__soldout">{{ 'products.product.sold_out' | t }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- if shown == 0 -%}
            {%- for i in (1..3) -%}
              <div class="pdp-bundle__item look__item">
                <div class="pdp-bundle__img">{{ 'product-2' | placeholder_svg_tag }}</div>
                <div class="pdp-bundle__info"><span class="pdp-bundle__name">Pick a product in the theme editor</span><div class="price"><span>£00.00</span></div></div>
                <span class="pdp-bundle__add">+</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn" style="margin-top:1.5rem;">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "none", "label": "Plain" }, { "value": "polka", "label": "Polka dots" }, { "value": "soft", "label": "Soft pink" } ], "default": "soft" },
    { "type": "image_picker", "id": "image", "label": "Outfit image" },
    { "type": "text", "id": "sticker", "label": "Image sticker", "default": "The dotty edit" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete the look" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Date night in dots" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pick your size and add each piece straight to your bag." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all outfits" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [ { "type": "product", "id": "product", "label": "Product" } ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Complete the look", "blocks": [ { "type": "product" }, { "type": "product" }, { "type": "product" } ] }
  ]
}
{% endschema %}
