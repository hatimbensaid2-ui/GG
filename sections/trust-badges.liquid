<div class="section section--tight" style="--cols: {{ section.blocks.size }};background:{{ section.settings.bg }};">
  <div class="page-width">
    <div class="trust-row">
      {%- for block in section.blocks -%}
        <div class="trust-item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}{% render 'icon-truck' %}
            {%- when 'return' -%}{% render 'icon-return' %}
            {%- when 'sparkle' -%}{% render 'icon-sparkle' %}
            {%- when 'chat' -%}{% render 'icon-chat' %}
            {%- when 'heart' -%}{% render 'icon-heart' %}
          {%- endcase -%}
          <div class="trust-item__title">{{ block.settings.title }}</div>
          <p class="trust-item__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#FCE9EE" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          {"value":"truck","label":"Truck"}, {"value":"return","label":"Return"},
          {"value":"sparkle","label":"Sparkle"}, {"value":"chat","label":"Chat"}, {"value":"heart","label":"Heart"} ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders over $90" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Trust badges", "blocks": [
      { "type": "badge", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders over $90" } },
      { "type": "badge", "settings": { "icon": "return", "title": "Easy returns", "text": "30-day hassle free" } },
      { "type": "badge", "settings": { "icon": "sparkle", "title": "New every week", "text": "Fresh drops you'll love" } },
      { "type": "badge", "settings": { "icon": "chat", "title": "Here to help", "text": "Sweet support, always" } }
    ] }
  ]
}
{% endschema %}
