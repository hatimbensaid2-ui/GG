<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- style -%}
      :root {
        --color-bg: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-dark: {{ settings.color_accent_dark }};
        --color-button: {{ settings.color_button }};
        --color-button-text: {{ settings.color_button_text }};
        --color-border: {{ settings.color_border }};
        --button-radius: {{ settings.button_radius }}px;
        --radius: {{ settings.corner_radius }}px;
        --page-width: {{ settings.page_width }}px;
        --font-body: {{ settings.font_body.family }}, sans-serif;
        --font-heading: {{ settings.font_heading.family }}, serif;
        --font-body-weight: 400;
        --font-heading-weight: 700;
        --heading-scale: 1.2; --heading-spacing: .5px; --heading-transform: none;
        --section-spacing: 64px;
      }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <div class="section" style="min-height:100vh;display:grid;place-items:center;text-align:center;background:var(--color-bg);">
      <div class="page-width page-width--narrow">
        <h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,8vw,4.5rem);">{{ shop.name }}</h1>
        <p style="font-size:1.1rem;opacity:.8;">{{ 'general.password_page.opening_soon' | t | default: 'Something cute is coming soon ✿' }}</p>
        {{ content_for_layout }}
        {%- form 'storefront_password' -%}
          {{ form.errors | default_errors }}
          <div style="display:flex;gap:.5rem;max-width:420px;margin:1.5rem auto 0;">
            <input type="password" name="password" placeholder="Enter password" required style="flex:1;padding:.9rem 1.2rem;border-radius:var(--button-radius);border:1.5px solid var(--color-border);font-family:inherit;">
            <button type="submit" class="btn">Enter</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </body>
</html>
