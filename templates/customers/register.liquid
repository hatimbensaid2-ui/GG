<div class="section"><div class="page-width page-width--narrow" style="max-width:460px;">
  <div class="page-hero"><h1>{{ 'customer.register.title' | t }}</h1></div>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div style="display:grid;gap:1rem;">
      <input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" style="padding:.9rem 1.2rem;border-radius:var(--button-radius);border:1.5px solid var(--color-border);font-family:inherit;">
      <input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" style="padding:.9rem 1.2rem;border-radius:var(--button-radius);border:1.5px solid var(--color-border);font-family:inherit;">
      <input type="email" name="customer[email]" placeholder="{{ 'customer.register.email' | t }}" required style="padding:.9rem 1.2rem;border-radius:var(--button-radius);border:1.5px solid var(--color-border);font-family:inherit;">
      <input type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" required style="padding:.9rem 1.2rem;border-radius:var(--button-radius);border:1.5px solid var(--color-border);font-family:inherit;">
      <button type="submit" class="btn">{{ 'customer.register.submit' | t }}</button>
    </div>
  {%- endform -%}
</div></div>
