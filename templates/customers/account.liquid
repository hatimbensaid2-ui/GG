<div class="section"><div class="page-width">
  <div class="page-hero"><h1>{{ 'customer.account.title' | t }}</h1></div>
  <p style="text-align:center;"><a href="{{ routes.account_logout_url }}" class="link-underline">{{ 'customer.account.log_out' | t }}</a></p>
  <div class="collection-layout">
    <aside>
      <h3>{{ 'customer.account.details' | t }}</h3>
      {{ customer.default_address | format_address }}
      <a href="{{ routes.account_addresses_url }}" class="link-underline">{{ 'customer.account.view_addresses' | t }}</a>
    </aside>
    <div>
      <h3>{{ 'customer.orders.title' | t }}</h3>
      {%- if customer.orders.size > 0 -%}
        <table style="width:100%;border-collapse:collapse;">
          <thead><tr style="text-align:left;border-bottom:1px solid var(--color-border);">
            <th style="padding:.6rem;">{{ 'customer.orders.order_number' | t }}</th>
            <th style="padding:.6rem;">{{ 'customer.orders.date' | t }}</th>
            <th style="padding:.6rem;">{{ 'customer.orders.total' | t }}</th>
          </tr></thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom:1px solid var(--color-border);">
                <td style="padding:.6rem;"><a href="{{ order.customer_url }}" class="link-underline">{{ order.name }}</a></td>
                <td style="padding:.6rem;">{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td style="padding:.6rem;">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div></div>
