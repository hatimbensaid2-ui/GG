[
  {
    "name": "theme_info",
    "theme_name": "Girlgeous",
    "theme_version": "1.0.0",
    "theme_author": "Girlgeous",
    "theme_documentation_url": "https:\/\/girlgeous.com",
    "theme_support_url": "https:\/\/girlgeous.com\/pages\/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFF8F5"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Secondary background",
        "default": "#FCE9EE"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#3A2A2F"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Primary accent",
        "default": "#E8A0B4"
      },
      {
        "type": "color",
        "id": "color_accent_dark",
        "label": "Accent (dark)",
        "default": "#C25C7A"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#3A2A2F"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FFF8F5"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / badge",
        "default": "#C25C7A"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#EAD3D9"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading size scale",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 120
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": false
      },
      {
        "type": "range",
        "id": "heading_letter_spacing",
        "label": "Heading letter spacing",
        "min": 0,
        "max": 6,
        "step": 0.5,
        "unit": "px",
        "default": 0.5
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32x32 recommended)"
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "label": "Space between sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 18
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corner radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_hover_swap",
        "label": "Swap to second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "square", "label": "Square (1:1)" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "Show quick add button",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold (in your currency, whole number)",
        "default": 60
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" }
    ]
  }
]
