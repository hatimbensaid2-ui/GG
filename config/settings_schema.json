[
  {
    "name": "theme_info",
    "theme_name": "Girlgeous",
    "theme_version": "1.0.0",
    "theme_author": "Girlgeous",
    "theme_documentation_url": "https://girlgeous.site",
    "theme_support_url": "https://girlgeous.site"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg", "label": "Background", "default": "#FFF8F5" },
      { "type": "color", "id": "color_bg_alt", "label": "Soft background (cards, panels)", "default": "#FCE9EE" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#3A2A2F" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#F1DADF" },
      { "type": "color", "id": "color_accent", "label": "Accent (baby pink)", "default": "#F7C8D5" },
      { "type": "color", "id": "color_accent_dark", "label": "Accent dark (rose)", "default": "#C25C7A" },
      { "type": "color", "id": "color_button", "label": "Button background", "default": "#3A2A2F" },
      { "type": "color", "id": "color_button_text", "label": "Button text", "default": "#FFF8F5" },
      { "type": "color", "id": "color_sale", "label": "Sale price", "default": "#D2386C" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "playfair_display_n4" },
      { "type": "range", "id": "heading_scale", "label": "Heading size", "min": 80, "max": 140, "step": 5, "unit": "%", "default": 100 },
      { "type": "select", "id": "heading_transform", "label": "Heading case", "options": [ { "value": "none", "label": "Normal" }, { "value": "uppercase", "label": "Uppercase" } ], "default": "none" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "dm_sans_n4" }
    ]
  },
  {
    "name": "Polka dots",
    "settings": [
      { "type": "paragraph", "content": "The polka dot pattern used for section backgrounds, the announcement bar, dividers and accents." },
      { "type": "color", "id": "dot_color", "label": "Dot colour (on light backgrounds)", "default": "#F7C8D5" },
      { "type": "color", "id": "dot_color_on_pink", "label": "Dot colour (on pink backgrounds)", "default": "#FFFFFF" },
      { "type": "range", "id": "dot_size", "label": "Dot size", "min": 2, "max": 12, "step": 1, "unit": "px", "default": 5 },
      { "type": "range", "id": "dot_gap", "label": "Dot spacing", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 30 },
      { "type": "checkbox", "id": "dots_announcement", "label": "Dots on announcement bar", "default": true },
      { "type": "checkbox", "id": "dots_scallops", "label": "Scalloped edges on hero & footer", "default": true },
      { "type": "checkbox", "id": "dots_cards", "label": "Faint dots behind product images", "default": true }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1000, "max": 1800, "step": 20, "unit": "px", "default": 1440 },
      { "type": "range", "id": "section_spacing", "label": "Space between sections", "min": 80, "max": 280, "step": 10, "unit": "px", "default": 200 },
      { "type": "range", "id": "radius", "label": "Corner radius (images, cards)", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 18 },
      { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 x 32px .png" }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "checkbox", "id": "card_hover_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_quick_add", "label": "Show quick add button", "default": true },
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show vendor", "default": false }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart type", "options": [ { "value": "drawer", "label": "Drawer" }, { "value": "page", "label": "Page" } ], "default": "drawer" },
      { "type": "checkbox", "id": "cart_free_shipping_bar", "label": "Show free shipping progress bar", "default": true },
      { "type": "number", "id": "free_shipping_threshold", "label": "Free shipping threshold", "info": "In your store currency, e.g. 60", "default": 60 }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" }
    ]
  }
]
