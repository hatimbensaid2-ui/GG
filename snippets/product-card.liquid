{%- comment -%}
  Product card. Accepts: product (required)
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
  assign second = product.media[1]
-%}
<div class="product-card">
  <div class="product-card__media-wrap">
    <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media -%}
        <img class="product-card__img--one"
          src="{{ product.featured_media | image_url: width: 600 }}"
          srcset="{{ product.featured_media | image_url: width: 360 }} 360w, {{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 800 }} 800w"
          sizes="(max-width: 749px) 50vw, 25vw"
          alt="{{ product.featured_media.alt | default: product.title | escape }}" loading="lazy" width="600" height="800">
        {%- if second and settings.card_hover_image -%}
          <img class="product-card__img--two" src="{{ second | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="800">
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        {%- assign saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
        <span class="badge badge--sale">-{{ saving }}%</span>
      {%- endif -%}
      {%- for tag in product.tags -%}
        {%- assign t = tag | downcase -%}
        {%- if t == 'bestseller' or t == 'best seller' -%}<span class="badge">{{ 'products.product.bestseller' | t }}</span>{%- endif -%}
        {%- if t == 'new' -%}<span class="badge badge--new">{{ 'products.product.new' | t }}</span>{%- endif -%}
      {%- endfor -%}
    </div>

    {%- if settings.card_quick_add and product.available -%}
      <div class="product-card__quick">
        {%- if product.has_only_default_variant -%}
          <button type="button" class="quick-add-btn" data-quick-add="{{ variant.id }}">{{ 'products.product.quick_add' | t }}</button>
        {%- else -%}
          <a href="{{ product.url }}" class="quick-add-btn" style="display:block;text-align:center;">{{ 'products.product.choose_options' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}<div class="product-card__vendor">{{ product.vendor }}</div>{%- endif -%}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
    {%- assign color_option = nil -%}
    {%- for option in product.options_with_values -%}
      {%- assign oname = option.name | downcase -%}
      {%- if oname == 'color' or oname == 'colour' -%}{%- assign color_option = option -%}{%- endif -%}
    {%- endfor -%}
    {%- if color_option and color_option.values.size > 1 -%}
      <div class="product-card__swatches">
        {%- for value in color_option.values limit: 5 -%}
          {%- if value.swatch.color -%}
            <span class="swatch" style="background:{{ value.swatch.color }};" title="{{ value | escape }}"></span>
          {%- else -%}
            <span class="swatch" style="background:{{ value | handleize | split: '-' | last }};" title="{{ value | escape }}"></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
